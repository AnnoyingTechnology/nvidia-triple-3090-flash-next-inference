# Explicit public surface. Models, builds, private results and datasets stay local.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/README.md
!/CHECKPOINT.md
!/LICENSE
!/NOTICE
!/QUALITY-REFERENCE.json
!/api-requirements.lock
!/Dockerfile.eval-x3090
!/docs/
!/scripts/
!/profiles/
!/systemd/
!/run_native.sh
!/stop_native.sh
!/launch_record.py
!/wait_ready.py
!/bench.py
!/owner_api_check.py
!/fixtures.py
!/practical_cases.py
!/practical_eval.py
!/eval.py
!/grade.py
!/vision_compare.py
!/vision15_cases.py
!/results/
/results/*
!/results/public/
!/fixtures/
/fixtures/*
!/fixtures/vision15/
/fixtures/vision15/photos/
__pycache__/
*.pyc
.env
*.part
*.tmp
